# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection URL
# Local: postgresql://postgres:postgres@localhost:5432/dockflow
# Azure: postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/dockflow?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dockflow

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:8081,http://localhost:3000,http://localhost:5173

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret-at-least-64-chars

# ─── Azure Blob Storage ───────────────────────────────────────────────────────
# Leave empty to use local ./uploads folder fallback
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_DOCUMENTS=documents

# ─── Azure Communication Services (SMS) ──────────────────────────────────────
# Leave empty to log SMS to console instead of sending
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_SMS_FROM_NUMBER=+15550000000

# ─── Azure SignalR ────────────────────────────────────────────────────────────
# Leave empty to use local WebSocket server on WS_PORT
AZURE_SIGNALR_CONNECTION_STRING=
AZURE_SIGNALR_HUB=dockflow
WS_PORT=4001

# ─── Microsoft Teams ──────────────────────────────────────────────────────────
# Leave empty to log Teams messages to console instead of sending
TEAMS_WEBHOOK_URL=
